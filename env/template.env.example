# zed-web-server environment schema — names and meanings only, never real values.
# Real values live encrypted in env/enc/<name>.env.enc (sops + age).
# Edit with `just edit <name>`; activate with `just use <name>`.
#
# The process loads ./.env via dotenvy at startup (src/server.rs); every
# variable is optional and falls back to the documented default.

# --- Postgres (read-only registry pool) --------------------------------------
# The ONLY secret-class variable in this repo: in prod it is a credentialed
# URL (k8s sources it from ExternalSecret ZED_WEB_DATABASE_URL). Enter real
# credentials via `just edit <name>` ONLY — a URL with a password that transits
# chat, a shell command, or a plaintext file is burned and must be rotated
# (see the credential policy / DEN-2836). Unset => the UI starts in
# registry-offline mode by design.
DATABASE_URL=EXAMPLE-postgres://zed:enter-via-just-edit@host:5432/zed

# Connection-pool startup policy (non-secret tuning; defaults 10 / 8000 / 30,
# see RUNTIME.md — statement timeout must stay below the HTTP timeout).
DB_MAX_CONNECTIONS=10
DB_STATEMENT_TIMEOUT_MS=8000
DB_CONNECT_MAX_WAIT_SECS=30

# --- HTTP --------------------------------------------------------------------
# Listen address; default 0.0.0.0:8081 (Dockerfile and k8s set the same).
BIND_ADDR=0.0.0.0:8081
# Public registry API base linked from the UI; identifier, not a secret.
# Default: zed_interfaces::registry::DEFAULT_REGISTRY_URL.
PUBLIC_REGISTRY_URL=https://registry.zpkg.net

# --- Observability -----------------------------------------------------------
# tracing_subscriber EnvFilter; default "info".
RUST_LOG=info
